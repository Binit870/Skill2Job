# ── Server ────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────
# Your deployed Node backend URL (used for CORS allow-list)
# .env.example
BACKEND_URL=https://localhost:5000

# ── Internal service-to-service auth ────────────────────────────────────
# Must match ML_INTERNAL_API_KEY set on the Node backend. Requests without
# a matching X-Internal-Api-Key header are rejected. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=7801cb228207af9f1c9ae2df5f61d7d31db789ce3db2fb73a43e958e5fb74df7
