# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Skill2Career

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# ── URLs ─────────────────────────────────────────────────────────────────
# Your deployed frontend URL — used for CORS and password-reset links
CLIENT_URL=http://localhost:5173
# Your deployed ML service URL
ML_SERVICE_URL=http://localhost:8000

# ── Internal service-to-service auth ────────────────────────────────────
# Must match INTERNAL_API_KEY set on the ML service. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_INTERNAL_API_KEY=replace-with-a-long-random-string

# ── Cloudinary (file uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (password reset) ──────────────────────────────────────────────
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
